POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://campus_agent:campus_agent@localhost:5432/campus_agent
DOCKER_DATABASE_URL=postgresql+psycopg://campus_agent:campus_agent@db:5432/campus_agent
LOCAL_STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:5173

CHAT_BASE_URL=https://api.example.com/v1
CHAT_API_KEY=
CHAT_MODEL=

EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# DeepTutor runs inside the application container. Do not publish port 8001.
DEEPTUTOR_VERSION=1.5.8
DEEPTUTOR_ENABLED=true
DEEPTUTOR_BASE_URL=http://127.0.0.1:8001
# Leave blank to derive `${EMBEDDING_BASE_URL}/embeddings`; use a full endpoint when required by the provider.
DEEPTUTOR_EMBEDDING_HOST=
DEEPTUTOR_EMBEDDING_MODEL=
DEEPTUTOR_EMBEDDING_DIMENSION=1536

# Optional direct overrides. Blank values fall back to CHAT_* / EMBEDDING_* above.
LLM_BINDING=
LLM_MODEL=
LLM_API_KEY=
LLM_HOST=
LLM_API_VERSION=
EMBEDDING_BINDING=
EMBEDDING_HOST=
EMBEDDING_DIMENSION=

# Leave blank for neutral, non-clickable sample campus information.
# Configure a JSON array of official RSS/Atom or selector-driven HTML sources in deployment.
CAMPUS_NEWS_SOURCES_JSON=
CAMPUS_NEWS_REFRESH_SECONDS=1800
CAMPUS_NEWS_MAX_STALE_SECONDS=604800
CAMPUS_NEWS_REQUEST_TIMEOUT_SECONDS=6
